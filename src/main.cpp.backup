#include <Arduino.h>
#include <BLEDevice.h>
#include <BLEClient.h>
#include <TFT_eSPI.h>
#include "credentials.h"

// BLE client setup
BLEClient* pClient = nullptr;
BLEAddress pairedPhoneAddress(TARGET_BLT_ADDRESS);
bool connected = false;
bool isPaired = false;
uint8_t pairedBDAddr[6] = {0};

// Display setup
TFT_eSPI tft = TFT_eSPI();

// RSSI threshold values for distance estimation
const int RSSI_AT_1M = -55;
const float PATH_LOSS = 2.0;

// Global variables
int32_t targetRSSI = 0;
bool targetFound = false;

float calculateDistance(int32_t rssi) {
  if (rssi == 0) return 0;
  float distance = pow(10.0, ((RSSI_AT_1M - rssi) / (10.0 * PATH_LOSS)));
  return distance;
}

void setupDisplay() {
  tft.init();
  tft.setRotation(1);
  tft.fillScreen(TFT_BLACK);
  tft.setTextColor(TFT_WHITE);
  tft.setTextSize(2);
  tft.drawString("BLE Locator", 10, 10);
}

void updateDisplay(int32_t rssi, float distance, const char* status) {
  tft.fillScreen(TFT_BLACK);

  tft.setTextColor(TFT_GREEN);
  tft.setTextSize(2);
  tft.drawString("BLE Locator", 5, 5);

  tft.setTextColor(TFT_WHITE);
  tft.setTextSize(1);
  tft.drawString(status, 5, 30);

  if (rssi != 0 && targetFound) {
    tft.drawString("Signal: " + String(rssi) + " dBm", 5, 50);
    tft.drawString("Distance: " + String(distance, 1) + " m", 5, 65);

    int barLength = (rssi + 100) * 2;
    if (barLength < 0) barLength = 0;
    if (barLength > 120) barLength = 120;

    tft.fillRect(5, 180, barLength, 10, TFT_GREEN);
    tft.drawRect(5, 180, 120, 10, TFT_WHITE);
  }
}

// Security Callback - Captures paired address
class MySecurityCallbacks : public BLESecurityCallbacks {
  uint32_t onPassKeyRequest() {
    Serial.println("PassKey requested - returning 000000");
    return 000000;
  }

  void onPassKeyNotify(uint32_t passKey) {
    Serial.print("PassKey: ");
    Serial.println(passKey);
  }

  bool onConfirmPIN(uint32_t passKey) {
    Serial.print("Confirming PassKey: ");
    Serial.println(passKey);
    return true;
  }

  bool onSecurityRequest() {
    Serial.println("Security request - accepting");
    return true;
  }

  void onAuthenticationComplete(esp_ble_auth_cmpl_t cmpl) {
    Serial.print("Pairing complete: ");
    Serial.println(cmpl.success ? "SUCCESS" : "FAILED");

    if (cmpl.success) {
      // Capture the paired device address
      Serial.print("Paired device address: ");
      for (int i = 0; i < 6; i++) {
        pairedBDAddr[i] = cmpl.bd_addr[i];
        if (cmpl.bd_addr[i] < 0x10) Serial.print("0");
        Serial.print(cmpl.bd_addr[i], HEX);
        if (i < 5) Serial.print(":");
      }
      Serial.println();

      // Update the pairing address
      pairedPhoneAddress = BLEAddress(pairedBDAddr);
      isPaired = true;
      Serial.println("Phone address captured. Will use for connection.");
    }
  }
};

void setupBLE() {
  BLEDevice::init("DeviceLocator");

  BLEAddress myAddress = BLEDevice::getAddress();
  Serial.print("ESP32 Bluetooth Address: ");
  Serial.println(myAddress.toString().c_str());

  BLEDevice::setSecurityCallbacks(new MySecurityCallbacks());
  BLEDevice::setEncryptionLevel(ESP_BLE_SEC_ENCRYPT_NO_MITM);

  BLEAdvertising *pAdvertising = BLEDevice::getAdvertising();
  pAdvertising->setMinPreferred(0x0);
  BLEDevice::startAdvertising();
  Serial.println("BLE advertising started - phone can pair with this device");
  Serial.println("Ready to accept pairing from phone");

  Serial.println("BLE initialized");
}

bool connectToPhone() {
  if (!isPaired) {
    Serial.println("Waiting for phone to pair first...");
    return false;
  }

  Serial.print("Attempting to connect to paired phone at ");
  Serial.println(pairedPhoneAddress.toString().c_str());

  if (pClient == nullptr) {
    pClient = BLEDevice::createClient();
    Serial.println("BLE Client created");
  }

  if (pClient->connect(pairedPhoneAddress, BLE_ADDR_TYPE_RANDOM)) {
    Serial.println("Successfully connected to phone!");
    connected = true;
    targetFound = true;
    return true;
  } else {
    Serial.println("Failed to connect to phone");
    connected = false;
    return false;
  }
}

int32_t readConnectionRSSI() {
  if (!pClient || !connected) {
    return 0;
  }

  int rssi = pClient->getRssi();
  return rssi;
}

void setup() {
  Serial.begin(115200);
  delay(100);

  Serial.println("\n\nBLE Device Locator - Paired Connection Mode");
  Serial.println("Waiting for phone to pair...");

  setupDisplay();
  setupBLE();

  Serial.println("Setup complete. Pair your phone with 'DeviceLocator' now.");
}

void loop() {
  if (!isPaired) {
    // Waiting for pairing
    updateDisplay(0, 0, "Waiting for pairing...");
    delay(1000);
  } else if (!connected) {
    // Try to connect to the paired phone
    updateDisplay(0, 0, "Connecting to phone...");
    connectToPhone();
    delay(2000);
  } else {
    // Connected - read RSSI and display distance
    targetRSSI = readConnectionRSSI();

    if (targetRSSI != 0 && targetRSSI != 127) {
      float distance = calculateDistance(targetRSSI);
      targetFound = true;

      Serial.print("Phone RSSI: ");
      Serial.print(targetRSSI);
      Serial.print(" dBm, Distance: ");
      Serial.print(distance, 1);
      Serial.println(" m");

      updateDisplay(targetRSSI, distance, "Connected!");
    } else {
      // Connection lost
      Serial.println("Connection lost, attempting to reconnect...");
      connected = false;
      targetFound = false;
      if (pClient) {
        pClient->disconnect();
      }
    }

    delay(1000);
  }
}
